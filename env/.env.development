# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'development'
# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = false
# 是否开启sourcemap
VITE_SHOW_SOURCEMAP = false

# 后台请求地址
VITE_SERVER_BASEURL = 'http://192.168.31.117:5173'
# 兼容原项目的 BASE_URL
VITE_BASE_URL = 'http://192.168.31.117:5173'

# 是否启用 Mock 模式（后端不可用时模拟登录）
VITE_MOCK_ENABLED = true
